{
  "manifest_version": 3,
  "name": "Gemini Argon Web Bridge",
  "version": "1.1.3",
  "description": "Connect local argon CLI to your existing Gemini web session and account permissions.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1:8989/*", "https://gemini.google.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"]}],
  "action": {"default_popup": "popup.html", "default_title": "Argon Bridge"}
}
